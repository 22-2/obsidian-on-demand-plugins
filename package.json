{
    "name": "on-demand-plugins",
    "type": "module",
    "version": "3.6.3",
    "description": "Lazy load plugins by caching their commands. Plugins are enabled on-demand when you trigger their commands (or open specific views), keeping startup fast.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "typecheck": "tsc6 -noEmit -skipLibCheck",
        "test:e2e": "playwright test --grep-invert @serial && playwright test --grep @serial --workers=1",
        "test:e2e:coverage": "node scripts/e2e-coverage.mjs",
        "readme:shots": "playwright test --config playwright.readme.config.ts --workers=1",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:install-browsers": "playwright install --with-deps",
        "build": "pnpm run typecheck && pnpm run build:nocheck",
        "build:nocheck": "node esbuild.config.mjs production",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:coverage:merge": "node scripts/merge-coverage.mjs",
        "test:coverage:all": "pnpm run test:coverage && pnpm run test:e2e:coverage && pnpm run test:coverage:merge",
        "lint": "pnpm exec eslint ./src",
        "format": "pnpm run lint --fix && pnpm exec prettier --editorconfig --write ./src && pnpx organize-imports-cli tsconfig.json",
        "release": "release-it",
        "release:dry": "release-it --dry-run --ci",
        "release:with-versions": "release-it --config .release-it.with-versions.json",
        "verify-build": "node scripts/verify-release-assets.mjs"
    },
    "keywords": [],
    "author": "22-2",
    "repository": "https://github.com/22-2/obsidian-on-demand-plugins.git",
    "license": "MIT",
    "dependencies": {
        "async-mutex": "^0.5.0",
        "loglevel": "^1.9.2",
        "monkey-around": "^3.0.0",
        "p-event": "^8.0.1",
        "p-queue": "^9.3.5",
        "p-timeout": "^7.0.2",
        "p-wait-for": "^6.0.0",
        "store2": "^2.14.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@obsidian-typings/obsidian-public-latest": "^6.41.0",
        "@playwright/test": "^1.64.0",
        "@release-it/bumper": "^8.0.1",
        "@release-it/conventional-changelog": "^12.0.2",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "5.0.3",
        "@vitest/ui": "^5.0.3",
        "conventional-changelog-conventionalcommits": "^10.4.1",
        "electron": "44.7.0",
        "esbuild": "0.28.2",
        "eslint": "^10.12.0",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "jsonc-parser": "^3.3.1",
        "moment": "^2.31.0",
        "obsidian": "^1.14.4",
        "obsidian-e2e-toolkit": "github:22-2/obsidian-e2e-toolkit#31a588132ff6b921018b81a0194f709cac32ae55",
        "playwright": "^1.64.0",
        "prettier": "^3.9.10",
        "release-it": "^21.1.1",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3"
    }
}
